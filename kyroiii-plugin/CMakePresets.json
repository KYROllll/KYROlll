{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-arm64",
      "displayName": "macOS Apple Silicon (Release)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "KYROIII_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS Universal (Release)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-universal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "KYROIII_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "jobs": 8
    },
    {
      "name": "macos-universal",
      "configurePreset": "macos-universal",
      "jobs": 8
    }
  ]
}
